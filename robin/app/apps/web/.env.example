# --- Owner / org identity -------------------------------------------------
# Personalizes greetings, prompts, transcript speaker labels, and the about
# page. Leave any of these blank to get a fully generic experience ("You",
# "your AI partner and second brain", etc.).

# The human this brain belongs to (e.g. Alex). Server-side.
ROBIN_OWNER=
# The org/company this brain serves (e.g. ExampleCo). Optional. When set, the
# interviewer persona reads "...second brain at <ORG>". Server-side.
ROBIN_ORG=
# Comma-separated proper nouns to bias live meeting transcription (Deepgram
# keyterms): product names, project codenames, etc. e.g. "Acme,Widget,Foo"
ROBIN_ORG_GLOSSARY=
# Owner label exposed to the browser (chat speaker label). Must be the
# NEXT_PUBLIC_ variant since it is read in a client component; set it to the
# same value as ROBIN_OWNER. Inlined at build time.
NEXT_PUBLIC_ROBIN_OWNER=

# --- Vault ----------------------------------------------------------------
# Robin vault root (absolute path).
ROBIN_VAULT=/absolute/path/to/your/vault

# --- Runtime security -----------------------------------------------------
# Local is the default: the npm dev/start scripts bind to 127.0.0.1 and the
# request guard rejects non-loopback Host/Origin values.
ROBIN_REMOTE_ACCESS=local
#
# Remote access is opt-in and fail-closed. Set ALL three values, terminate TLS
# in front of Robin, and preserve the original Host header:
# ROBIN_REMOTE_ACCESS=authenticated
# ROBIN_API_TOKEN=<random secret, at least 32 characters>
# ROBIN_PUBLIC_ORIGIN=https://robin.example.com
ROBIN_API_TOKEN=
ROBIN_PUBLIC_ORIGIN=

# --- Assistant ------------------------------------------------------------
# ASSISTANT_MODE=stub returns deterministic local responses without Claude CLI.
ASSISTANT_MODE=claude
ASSISTANT_CLAUDE_CWD=/absolute/path/to/your/repo
ASSISTANT_SESSION_FILE=/absolute/path/to/your/vault/.robin/assistant-session.json

# --- Interview voice relay (xAI Realtime) ---------------------------------
# Voice-to-voice interview that reads and searches your brain live.
# To ACTUALLY use it, set ROBIN_XAI_MODE=real AND a real XAI_API_KEY below.
# Leave ROBIN_XAI_MODE=stub (XAI_API_KEY blank) to get scripted offline frames
# for local testing — no xAI connection, no credits spent.
ROBIN_XAI_MODE=stub
# Your xAI API key, from https://console.x.ai. Required when ROBIN_XAI_MODE=real.
XAI_API_KEY=
INTERVIEW_MODEL=grok-voice-think-fast-1.0
INTERVIEW_VOICE=eve
# Bind + port for the standalone relay WebSocket server. Loopback is the safe
# default. A non-loopback INTERVIEW_WS_HOST is refused unless authenticated
# remote mode above is fully configured; put that socket behind TLS as well.
INTERVIEW_WS_HOST=127.0.0.1
INTERVIEW_WS_PORT=8401
# Optional. The relay gates connections with a short-lived HMAC session token.
# The signing secret is auto-generated per process and shared in-memory, so
# leave this BLANK for the normal single-process app. Pin it ONLY if you split
# the mint route and the relay into separate processes (both must then match).
INTERVIEW_SESSION_SECRET=
# Optional additional browser origins allowed to open the relay. The exact
# ROBIN_PUBLIC_ORIGIN is included automatically in authenticated remote mode.
# localhost / 127.0.0.1 are always allowed; leave blank for local use.
INTERVIEW_ALLOWED_ORIGINS=

# --- Meeting transcription ------------------------------------------------
# stub uses fixtures; local uses whisper-node; openai uses OPENAI_API_KEY.
ROBIN_WHISPER_MODE=stub
OPENAI_API_KEY=

# Live meeting STT (in-browser streaming). The /api/meeting/deepgram-token
# route mints short-lived tokens from this key. Get one at
# https://console.deepgram.com.
DEEPGRAM_API_KEY=

# Meeting AI processing (Process step: title, summary, key points, action items,
# speaker naming, conservative transcript cleanup). Runs via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Native Meeting Recorder boundary.
MEETING_RECORDER_APP_PATH=/Applications/Meeting Recorder.app
MEETING_RECORDER_HELPER_URL=

# Optional GitHub owner used to resolve repo#pr-N / repo#run-N links in Memory.
# Empty means shorthand refs remain plain text. Inlined at build time.
NEXT_PUBLIC_ROBIN_GITHUB_ORG=

# Optional comma-separated recipient names for inferred output grouping.
# Keep real customer and leadership names in your private .env.local.
ROBIN_EXTERNAL_RECIPIENTS=
ROBIN_LEADERSHIP_RECIPIENTS=
