{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robin.local/schemas/v1/transaction-receipt.schema.json",
  "title": "Robin pending vault mutation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "transaction_id",
    "operation",
    "created_at",
    "target_path",
    "event"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "enum": ["delete", "move", "write"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "target_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.?(?:/|$))(?!.*//)(?!.*\\/\\.\\.?(?:/|$))(?!.*\\\\)[^\\r\\n]+$"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.?(?:/|$))(?!.*//)(?!.*\\/\\.\\.?(?:/|$))(?!.*\\\\)[^\\r\\n]+$"
    },
    "tombstone_path": {
      "type": "string",
      "pattern": "^\\.robin/transactions/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.deleted$"
    },
    "event": {
      "allOf": [
        {
          "$ref": "edit-event.schema.json"
        },
        {
          "type": "object",
          "required": ["schema_version", "transaction_id", "kind"],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "transaction_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "open"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "move"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\.\\.?(?:/|$))(?!.*//)(?!.*\\/\\.\\.?(?:/|$))(?!.*\\\\)[^\\r\\n]+$"
          }
        },
        "required": ["source_path"],
        "not": {
          "properties": {
            "tombstone_path": {}
          },
          "required": ["tombstone_path"]
        }
      },
      "else": {
        "not": {
          "properties": {
            "source_path": {}
          },
          "required": ["source_path"]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "tombstone_path": {}
        },
        "required": ["tombstone_path"]
      },
      "else": {
        "not": {
          "properties": {
            "tombstone_path": {}
          },
          "required": ["tombstone_path"]
        }
      }
    }
  ]
}
